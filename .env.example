# backend-service 환경변수 예시 — 복사해서 .env 로 쓴다. 실제 값은 EC2 의 .env 에만.
# 로컬: 전부 비워도 뜬다 (compose 기본값: DB = 같은 compose 의 postgres, 모델 = 같은 compose 의 model)

# ── DB ── 없으면 '저장 없이' 동작 (api 로그에 경고, 30초마다 재연결)
DATABASE_URL=postgresql://carepong:carepong@db:5432/carepong

# ── 모델 서버 ── AWS 는 ML EC2 사설 IP (예 http://172.31.x.x:8001)
MODEL_URL=http://model:8001
# 키보드 개인화 훅 (혜윤 shrinkage z-벡터 → model /predict standardized=true). 0 이면 끔
KBD_PERSONALIZE=1

# ── 공감챗 (Bedrock Prompt Management) ── ARN 없으면 /v1/chat 503 → 앱 규칙 응답 폴백
BEDROCK_PROMPT_ARN=
BEDROCK_REGION=ap-northeast-2
BEDROCK_HISTORY_VAR=history
BEDROCK_CONNECT_TIMEOUT=3
BEDROCK_READ_TIMEOUT=12
CHAT_DAILY_MAX=30
CHAT_FILTER_REPLY=하고 싶은 말을 조금만 더 적어 주실래요?

# ── 복약 LUI·DDI ── 파싱 모델(Bedrock Nova)·DDI Lambda(정화)
MEDICATION_LUI_MODEL_ID=apac.amazon.nova-lite-v1:0
MEDICATION_LAMBDA_NAME=carepong-medication-orchestrator
MEDICATION_DEFAULT_TIMEZONE=Asia/Seoul
MEDICATION_OCCURRENCE_HORIZON_DAYS=30

# ── 외부 API 키 (제품 검색 프록시) ──
DATA_GO_KR_KEY=
FOODSAFETY_KEY=

# ── AWS ── EC2 인스턴스 역할을 쓰면 키는 비운다
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
